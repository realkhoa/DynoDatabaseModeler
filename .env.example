# ==============================================================================
# DynoDbModeler Test Database Environment Configuration
# ==============================================================================

# Common Defaults
DB_USER=dyno_user
DB_PASSWORD=dyno_password_123
DB_NAME=dyno_test

# PostgreSQL (Host port 5433 to avoid conflict with existing local services on 5432)
POSTGRES_PORT=5433
POSTGRES_USER=dyno_user
POSTGRES_PASSWORD=dyno_password_123
POSTGRES_DB=dyno_test

# MySQL
MYSQL_PORT=3306
MYSQL_ROOT_PASSWORD=dyno_root_password_123
MYSQL_USER=dyno_user
MYSQL_PASSWORD=dyno_password_123
MYSQL_DATABASE=dyno_test

# MariaDB
MARIADB_PORT=3307
MARIADB_ROOT_PASSWORD=dyno_root_password_123
MARIADB_USER=dyno_user
MARIADB_PASSWORD=dyno_password_123
MARIADB_DATABASE=dyno_test

# Microsoft SQL Server 2022
# Note: SA password must meet SQL Server complexity requirements (upper, lower, digit, symbol)
MSSQL_PORT=1433
MSSQL_SA_PASSWORD=DynoPassword123!
MSSQL_DB=dyno_test

# MongoDB
MONGO_PORT=27017
MONGO_INITDB_ROOT_USERNAME=dyno_user
MONGO_INITDB_ROOT_PASSWORD=dyno_password_123
MONGO_DATABASE=dyno_test

# Redis
REDIS_PORT=6379
REDIS_PASSWORD=dyno_password_123

# Adminer Web UI
ADMINER_PORT=8080
